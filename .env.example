# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - DEMO COLAS AZURE (SERVICE BUS PoC)
# ==============================================================================
# Copia este archivo a un archivo '.env' o expórtalas en tu terminal.
# IMPORTANTE: Nunca subas tu archivo '.env' con claves reales a control de versiones.

# ------------------------------------------------------------------------------
# 1. Azure Service Bus - Cola de Entrada (Input Queue)
# ------------------------------------------------------------------------------
# Cadena de conexión con permiso LISTEN para que el listener consuma mensajes
AZURE_SERVICEBUS_INPUT_CONNECTION_STRING=Endpoint=sb://<tu-namespace-entrada>.servicebus.windows.net/;SharedAccessKeyName=ListenPolicy;SharedAccessKey=<clave-listen>
AZURE_SERVICEBUS_INPUT_QUEUE_NAME=input-queue

# Cadena de conexión con permiso SEND para enviar mensajes de prueba vía POST /api/messages/send
# (Si tu namespace usa la misma clave SAS con ambos permisos, puedes dejar la misma)
AZURE_SERVICEBUS_INPUT_SENDER_CONNECTION_STRING=Endpoint=sb://<tu-namespace-entrada>.servicebus.windows.net/;SharedAccessKeyName=SendPolicy;SharedAccessKey=<clave-send>

# ------------------------------------------------------------------------------
# 2. Azure Service Bus - Cola de Salida (Output Queue)
# ------------------------------------------------------------------------------
# Cadena de conexión con permiso SEND para reenviar mensajes enriquecidos
AZURE_SERVICEBUS_OUTPUT_CONNECTION_STRING=Endpoint=sb://<tu-namespace-salida>.servicebus.windows.net/;SharedAccessKeyName=SendPolicy;SharedAccessKey=<clave-send>
AZURE_SERVICEBUS_OUTPUT_QUEUE_NAME=output-queue

# ------------------------------------------------------------------------------
# 3. Políticas de Reintentos y Retención de Bloqueo
# ------------------------------------------------------------------------------
# Reintentos automáticos a nivel de transporte AMQP (Azure SDK)
AZURE_SERVICEBUS_RETRY_MAX_RETRIES=3
AZURE_SERVICEBUS_RETRY_DELAY=1s
AZURE_SERVICEBUS_RETRY_MAX_DELAY=10s

# Retención de bloqueo automático mientras el mensaje se procesa
AZURE_SERVICEBUS_MAX_AUTO_LOCK_RENEW_DURATION=5m
# Límite de entregas antes de mover a Dead-Letter Queue (DLQ)
AZURE_SERVICEBUS_MAX_DELIVERY_COUNT=5

# ------------------------------------------------------------------------------
# 4. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
# Valores por defecto para el contenedor iniciado con docker-compose.yml
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/demo_colas
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
